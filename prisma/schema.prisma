generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String            @id @default(cuid())
  email        String            @unique
  passwordHash String
  name         String?
  memberships  WorkspaceMember[]
  sessions     Session[]
  auditLogs    AuditLog[]
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([token])
}

model Workspace {
  id           String            @id @default(cuid())
  name         String
  slug         String            @unique
  members      WorkspaceMember[]
  campaigns    Campaign[]
  links        Link[]
  domains      CustomDomain[]
  auditLogs    AuditLog[]
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
}

model WorkspaceMember {
  id          String    @id @default(cuid())
  workspaceId String
  userId      String
  role        String    @default("VIEWER") // OWNER, ADMIN, EDITOR, VIEWER
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())

  @@unique([workspaceId, userId])
  @@index([userId])
}

model Campaign {
  id          String    @id @default(cuid())
  workspaceId String
  name        String
  description String?
  channel     String?
  utmSource   String?
  utmMedium   String?
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  links       Link[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([workspaceId, name])
}

model Link {
  id             String          @id @default(cuid())
  workspaceId    String
  campaignId     String?
  code           String          @unique
  title          String?
  destinationUrl String
  status         String          @default("ACTIVE") // ACTIVE, PAUSED, ARCHIVED, DELETED
  redirectCode   Int             @default(302)
  expiresAt      DateTime?
  workspace      Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  campaign       Campaign?       @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  versions       LinkVersion[]
  events         RedirectEvent[]
  qrAssets       QrAsset[]
  abuseReports   AbuseReport[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([workspaceId, status])
  @@index([campaignId])
  @@index([code])
}

model LinkVersion {
  id             String   @id @default(cuid())
  linkId         String
  versionNumber  Int
  destinationUrl String
  title          String?
  changeReason   String?
  actorUserId    String?
  link           Link     @relation(fields: [linkId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())

  @@unique([linkId, versionNumber])
  @@index([linkId])
}

model QrAsset {
  id        String   @id @default(cuid())
  linkId    String
  styleJson String?
  link      Link     @relation(fields: [linkId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([linkId])
}

model RedirectEvent {
  id            String   @id @default(cuid())
  linkId        String
  occurredAt    DateTime @default(now())
  eventType     String   @default("redirect")
  referrerHost  String?
  deviceClass   String?  // Desktop, Mobile, Tablet, Bot
  browserFamily String?  // Chrome, Safari, Firefox, Edge, Other
  osFamily      String?  // macOS, Windows, iOS, Android, Linux, Other
  countryCode   String?  // ISO 2-letter, e.g. "US", "IN"
  link          Link     @relation(fields: [linkId], references: [id], onDelete: Cascade)

  @@index([linkId, occurredAt])
  @@index([occurredAt])
}

model CustomDomain {
  id                String    @id @default(cuid())
  workspaceId       String
  hostname          String    @unique
  verificationToken String
  status            String    @default("PENDING") // PENDING, VERIFIED, FAILED
  tlsStatus         String    @default("PENDING") // PENDING, ISSUED, FAILED
  workspace         Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdAt         DateTime  @default(now())

  @@index([workspaceId])
}

model AbuseReport {
  id             String    @id @default(cuid())
  linkId         String?
  shortCode      String
  reporterEmail  String?
  category       String
  description    String
  status         String    @default("PENDING") // PENDING, INVESTIGATING, RESOLVED, DISMISSED
  reviewedBy     String?
  link           Link?     @relation(fields: [linkId], references: [id], onDelete: SetNull)
  createdAt      DateTime  @default(now())

  @@index([shortCode])
  @@index([status])
}

model AuditLog {
  id           String    @id @default(cuid())
  workspaceId  String
  actorUserId  String
  action       String
  targetType   String
  targetId     String
  metadataJson String?
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  actor        User      @relation(fields: [actorUserId], references: [id], onDelete: Cascade)
  occurredAt   DateTime  @default(now())

  @@index([workspaceId, occurredAt])
}
