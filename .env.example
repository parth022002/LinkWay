# LinkWay Environment Variables Example
# Duplicate this file to .env.local for local development. Never commit .env.local to Git.

# Primary Database Connection (PostgreSQL for production, SQLite supported for local dev)
DATABASE_URL="file:./dev.db"

# Public Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional Dedicated Short Domain (defaults to NEXT_PUBLIC_APP_URL)
NEXT_PUBLIC_SHORT_DOMAIN="http://localhost:3000"

# Authentication Session Secret (Generate with: openssl rand -base64 32)
AUTH_SECRET="dev-insecure-secret-key-change-in-production-min-32-chars-long"

# Optional Edge Redis Cache & Rate Limiting (Upstash)
# UPSTASH_REDIS_REST_URL=""
# UPSTASH_REDIS_REST_TOKEN=""

# Optional URL Safety Screening (Google Safe Browsing / Cloudflare)
# SAFE_BROWSING_API_KEY=""

# Optional Transactional Email (Resend)
# RESEND_API_KEY=""
# EMAIL_FROM="LinkWay <noreply@linkway.app>"
